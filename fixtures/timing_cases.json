  "invalid_cases": [
    {
      "id": "phase_jump_in_continuous_grid",
      "segments": [
        {
          "start_time_sec": 0.25,
          "start_beat_q": 0,
          "bpm_quarter": 120,
          "grid_division": 4
        },
        {
          "start_time_sec": 2.35,
          "start_beat_q": 4,
          "bpm_quarter": 120,
          "grid_division": 4
        }
      ],
      "expected_continuous_second_marker_time_sec": 2.25,
      "expected_error_code": "GRID_DISCONTINUITY"
    },
    {
      "id": "note_before_first_marker",
      "segments": [
        {
          "start_time_sec": 0.25,
          "start_beat_q": 0,
          "bpm_quarter": 120,
          "grid_division": 4
        }
      ],
      "note": {
        "final_time_sec": 0.125,
        "beat_q": -0.25,
        "lane": 0
      },
      "expected_error_code": "GRID_NOT_COVERING_NOTES"
    },
    {
      "id": "lane_outside_four_drums",
      "note": {
        "final_time_sec": 0.25,
        "beat_q": 0,
        "lane": 4
      },
      "expected_error_code": "EXPORT_INVALID",
      "expected_detail": "lane must be an integer from 0 through 3"
    },
    {
      "id": "zero_bpm",
      "segment": {
        "start_time_sec": 0.25,
        "start_beat_q": 0,
        "bpm_quarter": 0,
        "grid_division": 4
      },
      "expected_error_code": "EXPORT_INVALID",
      "expected_detail": "bpm_quarter must be finite and positive"
    },
    {
      "id": "duplicate_lane_and_time",
      "notes": [
        {
          "final_time_sec": 0.25,
          "lane": 1
        },
        {
          "final_time_sec": 0.25,
          "lane": 1
        }
      ],
      "expected_error_code": "EXPORT_INVALID",
      "expected_detail": "duplicate lane/time"
    },
    {
      "id": "missing_final_audio",
      "assets_present": [
        "info.dat",
        "Easy.dat",
        "cover.jpg"
      ],
      "expected_error_code": "EXPORT_INVALID",
      "expected_detail": "referenced song.ogg is absent"
    }
  ],
  "non_json_negative_tests": [
    "Pass NaN and Infinity as Python float values; domain validation must reject them before JSON serialization."
  ]
}
