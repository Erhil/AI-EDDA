    "ArrangementRangeQ": {
      "additionalProperties": false,
      "properties": {
        "start_q": {
          "title": "Start Q",
          "type": "number"
        },
        "end_q": {
          "title": "End Q",
          "type": "number"
        }
      },
      "required": [
        "start_q",
        "end_q"
      ],
      "title": "ArrangementRangeQ",
      "type": "object"
    },
    "ArrangementRequest": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "generator_id": {
          "minLength": 1,
          "title": "Generator Id",
          "type": "string"
        },
        "generator_version": {
          "minLength": 1,
          "title": "Generator Version",
          "type": "string"
        },
        "audio_asset_id": {
          "minLength": 1,
          "title": "Audio Asset Id",
          "type": "string"
        },
        "audio_sha256": {
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Audio Sha256",
          "type": "string"
        },
        "analysis": {
          "$ref": "#/$defs/StrictObjectRef"
        },
        "plan": {
          "$ref": "#/$defs/StrictObjectRef"
        },
        "grid_revision": {
          "minimum": 0,
          "title": "Grid Revision",
          "type": "integer"
        },
        "chart": {
          "$ref": "#/$defs/StrictObjectRef"
        },
        "target": {
          "$ref": "#/$defs/TargetProfile"
        },
        "range_q": {
          "$ref": "#/$defs/ArrangementRangeQ"
        },
        "mode": {
          "enum": [
            "single_lane",
            "heuristic_arranger"
          ],
          "title": "Mode",
          "type": "string"
        },
        "lane": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lane"
        },
        "reference_chart": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrictObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference_influence": {
          "anyOf": [
            {
              "enum": [
                "rhythm_theme",
                "pattern_theme",
                "adaptation"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Influence"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "project_id",
        "generator_id",
        "generator_version",
        "audio_asset_id",
        "audio_sha256",
        "analysis",
        "plan",
        "grid_revision",
        "chart",
        "target",
        "range_q",
        "mode",
        "seed"
      ],
      "title": "ArrangementRequest",
      "type": "object"
    },
    "AudioAsset": {
