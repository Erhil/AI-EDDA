{
  "name": "ai-edda-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "generate:schema": "..\\\\.venv\\\\Scripts\\\\python.exe ../scripts/export_schema.py",
    "generate:types": "json2ts -i schema/ui-contract.json -o src/generated/ui-contract.ts",
    "generate": "npm run generate:schema && npm run generate:types",
    "test:frontend": "node ../scripts/check_frontend.mjs",
    "dev": "vite",
    "test:ui": "node ../scripts/check_frontend.mjs --ui-only",
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 5174 --strictPort",
    "test:demo": "node --test tests/demo/*.test.mjs && node tests/demo/browser.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "wavesurfer.js": "8.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "json-schema-to-typescript": "16.0.0",
    "msw": "3.0.5",
    "react-test-renderer": "19.3.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "license": "GPL-3.0-only"
}
